    <string name="onboarding_welcome_title">Welcome to MyAlarm</string>
    <string name="onboarding_welcome_subtitle">A Samsung-style alarm with 10–60 minute snooze you can adjust right while it rings.</string>
    <string name="onboarding_notif_title">Allow notifications</string>
    <string name="onboarding_notif_subtitle">Without this the app cannot wake you up.</string>
    <string name="onboarding_exact_title">Allow exact alarms</string>
    <string name="onboarding_exact_subtitle">So the alarm fires exactly on time, not plus-or-minus several minutes.</string>
    <string name="onboarding_fullscreen_title">Full-screen notifications</string>
    <string name="onboarding_fullscreen_subtitle">So the alarm screen shows up even on a locked phone. Disabling battery optimization is also recommended.</string>
    <string name="onboarding_overlay_title">Display over other apps</string>
    <string name="onboarding_overlay_subtitle">Backup channel. On GrapheneOS and some Android builds the system restricts full-screen notifications for sideload apps — this permission guarantees we can show the alarm screen over the lock screen.</string>

